  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules", "release"]
}
